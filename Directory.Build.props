<Project>
  <PropertyGroup>
    <!-- Set by release-please from conventional commits; do not edit by hand. -->
    <Version>0.1.0</Version> <!-- x-release-please-version -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET analysers at their recommended set, and the .editorconfig code style in every build.
         Rules that are switched off are in .editorconfig, each with its reason. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>

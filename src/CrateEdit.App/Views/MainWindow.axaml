<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrateEdit.App.ViewModels"
        xmlns:res="using:CrateEdit.App.Resources"
        x:Class="CrateEdit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{x:Static res:Strings.Menu_Help}">
        <MenuItem Header="{x:Static res:Strings.Command_OpenLogFolder}"
                  Tag="diagnostics.openLogFolder"
                  Command="{Binding OpenLogFolderCommand}" />
      </MenuItem>
    </Menu>
    <TextBlock x:Name="StatusBar"
               DockPanel.Dock="Bottom"
               Margin="12,6"
               Text="{Binding StatusText}" />
    <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="24"
               Text="{Binding Title}" />
  </DockPanel>
</Window>

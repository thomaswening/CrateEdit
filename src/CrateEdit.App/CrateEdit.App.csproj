<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="CrateEdit.App.Resources"
                      StronglyTypedClassName="Strings"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CrateEdit.Core\CrateEdit.Core.csproj" />
  </ItemGroup>
</Project>
